# ---------------------------------------------------------------------------
# API UAU / Trinus (Globaltec)
# Fluxo de autenticação em 3 camadas — ver docs/ "Manual de Integração e
# Autenticação UAU.pdf". Credenciais são entregues por cofre de senha / e-mail.
# ---------------------------------------------------------------------------

# Base do API Gateway Trinus (gera o access_token OAuth2 client_credentials)
UAU_GATEWAY_URL=https://api.trinus.co
# Base da UAUAPi (endpoints de dados)
UAU_API_BASE_URL=https://api.trinus.co/uau/v1

# Token de integração fornecido pela Globaltec -> header X-Integration-Authorization
UAU_TOKEN_INTEGRACAO=
# client_id do API Gateway Trinus
UAU_CLIENT_ID=
# CODIGO_AUTENTICACAO_TRINUS = base64(client_id:secret_id)
# usado no header "Authorization: Basic <...>" do gateway
UAU_TRINUS_BASIC=
# Usuário/senha do sistema UAU (endpoint AutenticarUsuario)
UAU_LOGIN=
UAU_SENHA=

# ---------------------------------------------------------------------------
# Destino: Postgres Supabase (schema uau)
# ---------------------------------------------------------------------------
SUPABASE_DB_URL=
# Supabase Storage (snapshot opcional do JSON bruto) — extra "storage"
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=uau-raw
